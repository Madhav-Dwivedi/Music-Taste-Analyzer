# Music Taste Analyzer — Local Environment Configuration
# Copy this file to `.env` (or configure your Client ID in Preferences inside the Web Studio).
# Never commit your real `.env`, `.spotify_client_id`, `.cache`, `ytm_browser.json`, or `ytm_oauth.json`.

# 1. Your Spotify Developer App Client ID (PKCE - no Client Secret required)
# Create one in https://developer.spotify.com/dashboard with Redirect URI: http://127.0.0.1:8080
SPOTIFY_CLIENT_ID=

# 2. Must match the Redirect URI registered in your Spotify Developer App
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080

# 3. Local Web Studio HTTP port (loopback 127.0.0.1 only)
MUSIC_ANALYZER_PORT=8765
